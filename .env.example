# Copy to .env and fill in. NEVER commit .env.
# Use random values WITHOUT `$` (Docker Compose would interpolate it):  openssl rand -hex 16

# Database password
POSTGRES_PASSWORD=
# 64 hex characters:  openssl rand -hex 32
APP_SECRET=

# Strongly recommended on any internet-facing install: only someone who knows this
# token can complete the first-run setup (it is asked for on the setup screen).
SETUP_TOKEN=

# Force Secure cookies. They are also enabled automatically when your proxy sends X-Forwarded-Proto: https
COOKIE_SECURE=false

# Proxy trust (see README, "Running in production")
# TRUST_PROXY=loopback,linklocal,uniquelocal
# CLIENT_IP_HEADER=cf-connecting-ip

# Limits
# MAX_UPLOAD_MB=100
# MAX_PAGES=300
# SESSION_DAYS=14
